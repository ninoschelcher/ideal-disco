# GitHub mode for the Keystatic admin on a deployed site.
# Local development uses filesystem storage and does not need these.
NEXT_PUBLIC_KEYSTATIC_GITHUB_REPO=

KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Contact form handler (https://web3forms.com). Public by design; inlined at
# build time. Without it the form falls back to a mailto: link.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
